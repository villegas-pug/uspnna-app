{
  "name": "uspnna-inventarios",
  "version": "0.1.0",
  "description": "Prototipo del Sistema Integral de Gestión de Inventarios USPNNA – INABIF",
  "productName": "Sistema Integral de Gestión de Inventarios – USPNNA",
  "author": "USPNNA – INABIF",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "mocks": "node scripts/generar-mocks.mjs",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.17",
    "quasar": "^2.17.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@quasar/app-vite": "^2.1.0",
    "@types/node": "^22.13.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "typescript": "~5.7.3",
    "vite-plugin-checker": "^0.9.0",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20",
    "npm": ">= 6.13.4"
  }
}
